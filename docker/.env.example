# Exemple de variables d'environnement pour la stack Docker prod.
# Copier en .env (gitignored) et remplir avec des valeurs robustes.
# Le script scripts/deploy.sh genere automatiquement un .env avec des valeurs
# aleatoires lors du premier deploiement.

MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_APP_PASSWORD=changeme-app
